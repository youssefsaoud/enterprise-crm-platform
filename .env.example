# Backend
SERVER_PORT=8080
CRM_CORS_ALLOWED_ORIGIN=http://localhost:4200

# PostgreSQL development database
CRM_DB_URL=jdbc:postgresql://localhost:5432/crm_dev
CRM_DB_USERNAME=crm_app
CRM_DB_PASSWORD=

# Authentication. Choose private local values; never commit your .env.local.
CRM_JWT_SECRET=
CRM_JWT_ISSUER=crm-api
CRM_JWT_EXPIRES_IN_SECONDS=3600
CRM_BOOTSTRAP_ADMIN_ENABLED=false
CRM_BOOTSTRAP_ADMIN_EMAIL=
CRM_BOOTSTRAP_ADMIN_PASSWORD=

# Docker Compose uses a separate database volume, not the native PostgreSQL server.
CRM_POSTGRES_DB=crm_dev
ORQ_FRONTEND_PORT=4201
ORQ_BACKEND_PORT=8081

# Employee invitations. Dev profile imports ignored .env.local as properties.
SMTP_USERNAME=
SMTP_PASSWORD=
FRONTEND_BASE_URL=http://localhost:4200
INVITATION_TTL_HOURS=24
# smtp sends mail; preview requires dev profile AND explicit preview enablement.
INVITATION_DELIVERY_MODE=smtp
INVITATION_PREVIEW_ENABLED=false
# Optional, explicitly chosen real SMTP smoke-test recipient (never guessed).
SMTP_TEST_RECIPIENT=
